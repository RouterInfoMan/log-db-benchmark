# ---- Resource fairness knobs: every log DB gets the SAME limits ----
DB_MEM_LIMIT=6g
DB_CPUS=4

# Elasticsearch JVM heap (must fit inside DB_MEM_LIMIT; ~50% is the ES guidance)
ES_HEAP=3096m

# ---- Image versions under test ----
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.3
LOKI_IMAGE=grafana/loki:3.6.16
VL_IMAGE=victoriametrics/victoria-logs:v1.52.0

# ---- Observability stack ----
PROM_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.5.2
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.11.0

# ---- Host ports ----
ES_PORT=9200
LOKI_PORT=3100
VL_PORT=9428
PROM_PORT=9090
GRAFANA_PORT=3000
PUSHGATEWAY_PORT=9091
EXPORTER_PORT=9101
